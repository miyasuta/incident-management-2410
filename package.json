{
  "name": "incident-management-2410",
  "version": "1.0.0",
  "description": "A simple CAP project.",
  "repository": "<Add your repository here>",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@sap/cds": "^8",
    "express": "^4",
    "@cap-js/hana": "^1",
    "@sap/xssec": "^4",
    "@sap/ams": "latest"
  },
  "devDependencies": {
    "@cap-js/cds-types": "^0.6",
    "@cap-js/sqlite": "^1",
    "@sap/cds-dk": "^8",
    "@sap/ux-specification": "UI5-1.129",
    "rimraf": "^5.0.5",
    "@sap/ams-dev": "latest"
  },
  "scripts": {
    "start": "cds-serve",
    "watch-incidents": "cds watch --open incidents/webapp/index.html?sap-ui-xx-viewCache=false",
    "undeploy": "cf undeploy incident-management-2410 --delete-services --delete-service-keys --delete-service-brokers",
    "build": "rimraf resources mta_archives && mbt build --mtar archive",
    "deploy": "cf deploy mta_archives/archive.mtar --retries 1"
  },
  "cds": {
    "requires": {
      "[development]": {
        "auth": {
          "ams" : {
          "autoCompile" : true,
          "cache" : {
                "TTL" : 0
            }
          },
          "kind": "mocked",
          "users": {
            "alice": {
              "policies" : [
                  "cap.support"
              ]
            },
            "bob": {
            }
          }
        }
      },
      "[production]": {
        "db": "hana",
        "auth": "xsuaa"
      },
      "html5-repo": true
    },
    "sql": {
      "native_hana_associations": false
    }
  },
  "sapux": [
    "app/incidents"
  ]
}
